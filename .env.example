# ── Variables de entorno para Docker Compose ──
# Copia este archivo como .env y configura los valores

# OpenAI (opcional, solo si usas OpenAI como proveedor)
OPENAI_API_KEY=sk-your-key-here

# Recuperación de contraseña — la API key de Resend y el remitente se
# configuran desde /admin/config (persistidos en DB), no aquí.
# URL pública del frontend, usada para armar el link del correo de reset
FRONTEND_URL=http://localhost:3001
